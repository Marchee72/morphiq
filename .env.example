# MorphIQ Environment Configuration Template
# Copy this file to '.env' in the same folder and fill in your values.

# ── AI Coach — LLM Provider ───────────────────────────────────────────────
# The coach uses any OpenAI-compatible API. Set the provider, model, and key.
#
# VITE_LLM_PROVIDER options:
#   deepseek    → https://api.deepseek.com        (default)
#   openai      → https://api.openai.com
#   groq        → https://api.groq.com/openai
#   together    → https://api.together.xyz
#   openrouter  → https://openrouter.ai/api
#   ollama      → http://localhost:11434/v1        (no key needed)
#   custom      → set VITE_LLM_BASE_URL manually
#
# Examples:
#   DeepSeek V4 Flash:  VITE_LLM_PROVIDER=deepseek  VITE_LLM_MODEL=deepseek-v4-flash
#   OpenAI GPT-4o:      VITE_LLM_PROVIDER=openai    VITE_LLM_MODEL=gpt-4o
#   Groq Llama 3.3 70B: VITE_LLM_PROVIDER=groq      VITE_LLM_MODEL=llama-3.3-70b-versatile
#   Local Ollama:       VITE_LLM_PROVIDER=ollama    VITE_LLM_MODEL=llama3.2  (no key needed)
VITE_LLM_PROVIDER=deepseek
VITE_LLM_MODEL=deepseek-v4-flash
VITE_LLM_API_KEY=your_api_key_here

# Custom base URL (only required when VITE_LLM_PROVIDER=custom)
# VITE_LLM_BASE_URL=https://your-custom-openai-compatible-endpoint.com/v1

# ── Database Mode ─────────────────────────────────────────────────────────
# Set to 'local' (default) for browser-based IndexedDB storage.
# Set to 'server' to sync data with the Raspberry Pi PostgreSQL backend.
VITE_DB_TYPE=local

# ── Server API URL ────────────────────────────────────────────────────────
# Required only when VITE_DB_TYPE=server.
# Use your Cloudflare Tunnel public URL (recommended), Tailscale IP, or LAN IP.
# Example (Cloudflare Tunnel): VITE_API_URL=https://morphiq.yourdomain.com
# Example (Tailscale VPN):     VITE_API_URL=http://100.103.57.4:3000
# Example (Local Wi-Fi LAN):   VITE_API_URL=http://192.168.1.150:3000
VITE_API_URL=https://morphiq.yourdomain.com

# ── Google Sign-In ────────────────────────────────────────────────────────────
# From Google Cloud Console → Credentials. Both are public.
#   Web client:     authorised origins must list every host the app runs on.
#   Android client: package com.morphiq.app2 plus the signing SHA-1. The debug
#                   and release keystores have different fingerprints; register
#                   both or sign-in breaks exactly when you publish.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_ANDROID_CLIENT_ID=

# ── Server-side only (never prefixed VITE_) ───────────────────────────────────
# GOOGLE_WEB_CLIENT_ID / GOOGLE_ANDROID_CLIENT_ID  accepted token audiences
# SESSION_SECRET                                    signs app sessions; keep secret
# AUTH_REQUIRED=true                                turn on only once every client
#                                                   sends a token, or the installed
#                                                   app stops working
